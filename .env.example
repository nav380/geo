# Copy this file to .env and fill in your real values.

# --- Vertex AI ---
# Path to the service-account JSON key file downloaded from Google Cloud IAM.
VERTEX_CREDENTIALS_PATH=/home/nav/Desktop/geoloactionapp/ai-site-selector/site-selector/vertax-new.json
# Your GCP project ID that has the Vertex AI API enabled.
VERTEX_PROJECT_ID=massive-marker-505813-q8
# Vertex AI region, e.g. us-central1
VERTEX_LOCATION=us-central1
# Gemini model available to your project on Vertex AI
GEMINI_MODEL=gemini-2.5-flash

# --- Google Maps Platform ---
# API key with Geocoding API, Places API, Distance Matrix API, and Maps JavaScript API enabled.
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# --- Workflow tuning (optional) ---
DEFAULT_SEARCH_RADIUS_KM=5
MAX_CANDIDATES=10
REQUEST_TIMEOUT_SECONDS=25
